# Copie para .env.production.local (deploy pela sua máquina) ou cadastre no painel
# da Cloudflare. Veja o README, seção "Colocar no ar (Cloudflare)".

# --- Supabase (Painel > Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
# Chave secreta: NUNCA compartilhe nem coloque no navegador.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Endereço público do site (sem barra no final)
NEXT_PUBLIC_SITE_URL=https://mentoriasnaap.com.br

# --- Marca d'água e contatos exibidos no site ---
NEXT_PUBLIC_NAAP_NAME=NAAP Psicologia
NEXT_PUBLIC_NAAP_EMAIL=contato@naappsicologia.com.br
NEXT_PUBLIC_NAAP_PHONE=(85) 99840-2825

# --- E-mails automáticos (Brevo: app.brevo.com > SMTP & API > API Keys) ---
BREVO_API_KEY=xkeysib-...
EMAIL_FROM_NAME=Mentorias NAAP
# Remetente verificado no Brevo (Senders & IP > Senders)
EMAIL_FROM_ADDRESS=contato@naappsicologia.com.br
# Recebe aviso quando alguém novo se cadastra
ADMIN_NOTIFY_EMAIL=contato@naappsicologia.com.br
